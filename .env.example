# ─── Required ────────────────────────────────────────────────────────────────
# Postgres. Supabase: Project → Settings → Database → Connection string (URI).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/bytebikri

# The public origin. Must match the domain you register — ad networks hash this
# value into their callbacks, so changing it invalidates existing connections.
PUBLIC_BASE_URL=https://example.com

# 32+ random bytes each. Generate with: openssl rand -base64 48
SESSION_SECRET=
ACCESS_TOKEN_SECRET=

# ─── Ad networks ─────────────────────────────────────────────────────────────
# Per-connection callback secrets are stored in the database, not here. These are
# only for local development of the postback path.
AD_POSTBACK_SECRET=dev-postback-secret-change-me

# ─── Storage (Phase 1) ───────────────────────────────────────────────────────
# Leave STORAGE_DRIVER=local for development.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=            # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto

# ─── Email (Phase 2) — stubbed until supplied ────────────────────────────────
EMAIL_DRIVER=console
# EMAIL_DRIVER=smtp
# SMTP_URL=

# ─── Operator details, shown on legal pages. Required before launch. ─────────
OPERATOR_LEGAL_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_COUNTRY=NP

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
