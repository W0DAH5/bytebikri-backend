# ─── Required ────────────────────────────────────────────────────────────────
# Postgres. Supabase: Project → Settings → Database → Connection string (URI).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/bytebikri

# The public origin. Must match the domain you register — ad networks hash this
# value into their callbacks, so changing it invalidates existing connections.
PUBLIC_BASE_URL=https://example.com

# 32+ random bytes each. Generate with: openssl rand -base64 48
SESSION_SECRET=
ACCESS_TOKEN_SECRET=

# ─── Ad networks ─────────────────────────────────────────────────────────────
# Per-connection callback secrets are stored in the database, not here. These are
# only for local development of the postback path.
AD_POSTBACK_SECRET=dev-postback-secret-change-me

# ─── Storage ─────────────────────────────────────────────────────────────────
# THERE IS NO BUCKET DRIVER YET. Uploaded files are written to the local
# filesystem by the `storage` adapter in app/src/store.js, and the environment
# variables that used to sit here (`STORAGE_DRIVER=s3`, `STORAGE_BUCKET`,
# `STORAGE_ENDPOINT`, `STORAGE_ACCESS_KEY_ID`, …) were read by NOTHING — setting
# them looked like configuring a bucket and silently kept writing to disk, which
# on a container host loses every file on every deploy while the database keeps
# the unlocks pointing at them. They are removed rather than left as a comment
# that reads like an enabled option.
#
# What to do instead, today: mount a volume at `app/.data` (DEPLOY.md §5). The
# path is fixed in the adapter, not an environment variable — and adding one here
# that the code does not read is the mistake this comment replaced.
#
# The bucket is three methods to implement (put/get/exists), and everything above
# the adapter is already unaware of where bytes live.

# ─── Email ───────────────────────────────────────────────────────────────────
# Two flows need this: a password reset link, and the link that confirms the
# address an account signed up with. With no way to deliver mail, a forgotten
# password is a lost account, and every address on the platform is a string
# nobody has ever proved they can read.
#
# The server REFUSES TO START in production with EMAIL_DRIVER unset or set to
# console — console prints the message to the log and delivers nothing, which
# looks healthy and locks out every user who forgets a password.
EMAIL_DRIVER=console
# Where messages come from. Required in production; anything not on your own
# domain lands in spam.
EMAIL_FROM=ByteBikri <no-reply@bytebikri.local>

# A JSON API. Needs only an HTTP call, so it works from any host.
# EMAIL_DRIVER=resend
# RESEND_API_KEY=

# A relay. Needs the nodemailer package installed on the deployment.
# EMAIL_DRIVER=smtp
# SMTP_URL=smtps://user:password@smtp.example:465

# ─── Operator details, shown on legal pages. Required before launch. ─────────
# The first four are the ones the privacy notice cannot be published without, and
# the page names whichever are empty rather than printing a placeholder. Country
# is only used where "the district whose courts hear disputes" needs a country.
OPERATOR_LEGAL_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_DISTRICT=
OPERATOR_COUNTRY=NP

# ─── Payment rails. Optional, and money only ever moves TO bytebikri. ────────
# A store's plan and rent, and a person's ByteBikri Plus month, arrive on these and
# are matched by hand at /admin/payments. Until one is set the billing page says
# "not configured" and names the variable, because an account number a person
# cannot check is worse than a wait. Nothing in the product ever pays out from
# here — a store pays its own members directly.
PAY_ESEWA_ID=
PAY_KHALTI_ID=
PAY_IMEPAY_ID=
PAY_BANK_ACCOUNT=

# ─── Observability ───────────────────────────────────────────────────────────
# NOT IMPLEMENTED, and named here so nobody sets them expecting an effect.
# `LOG_LEVEL` and `SENTRY_DSN` were read by nothing: the server writes plain
# console lines and no error reporter is wired. The two variables sat in this file
# from the first deploy round and would have been the first thing anyone reached
# for to quieten logs or catch a 500 in production — the same defect as the
# storage block above, found the same way.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
