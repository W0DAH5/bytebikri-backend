{
  "name": "bytebikri-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ByteBikri \u2014 storefronts, ad-gated content unlocks, ad slot allocation",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/boot.mjs",
    "dev": "node --watch scripts/boot.mjs",
    "test": "node scripts/test-db.mjs && node --test test/*.test.js",
    "db:start": "node scripts/dev-postgres.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:test": "node scripts/test-db.mjs",
    "secrets": "node -e \"import('./src/config.js').then(m=>{for(const n of ['SESSION_SECRET','ACCESS_TOKEN_SECRET','AD_POSTBACK_SECRET'])console.log(n+'='+m.generateSecret())})\"",
    "check:env": "node -e \"process.env.NODE_ENV=process.env.NODE_ENV||'production';import('./src/config.js').then(m=>{const r=m.checkConfig();console.log(m.formatConfigReport(r)||'  Configuration is complete.');process.exit(r.ok?0:1)})\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
