{
  "name": "bytebikri-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ByteBikri — storefronts, ad-gated content unlocks, ad slot allocation",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/boot.mjs",
    "dev": "node --watch scripts/boot.mjs",
    "test": "node scripts/test-db.mjs && node --test test/*.test.js",
    "db:start": "node scripts/dev-postgres.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:test": "node scripts/test-db.mjs",
    "secrets": "node -e \"import('./src/config.js').then(m=>{for(const n of ['SESSION_SECRET','ACCESS_TOKEN_SECRET','AD_POSTBACK_SECRET'])console.log(n+'='+m.generateSecret())})\"",
    "check:env": "node scripts/check-env.mjs",
    "shots": "node scripts/shoot.mjs",
    "audit:visual": "node scripts/audit.mjs",
    "video:check": "node scripts/video-check.mjs",
    "mastodon:check": "node scripts/mastodon-check.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^131.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "h264-mp4-encoder": "^1.0.12",
    "puppeteer-core": "^23.11.1"
  }
}
