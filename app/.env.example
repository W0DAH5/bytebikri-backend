# ByteBikri — copy to `.env` and fill in what you need. `.env` is gitignored.
#
# Nothing here is required for a local checkout: the demo runs on the
# development defaults and the local database. Listed in the order the config
# check reads them.

# ── Signing secrets (required in production; `npm run secrets` generates them) ──
# SESSION_SECRET=
# ACCESS_TOKEN_SECRET=
# AD_POSTBACK_SECRET=

# ── The public origin, and the operator account ──────────────────────────────
# PUBLIC_BASE_URL=https://example.com
# OPERATOR_EMAIL=
# OPERATOR_LEGAL_NAME=
# OPERATOR_ADDRESS=

# ── Database and email ──────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:pass@host:5432/bytebikri
# EMAIL_DRIVER=resend
# RESEND_API_KEY=
# EMAIL_FROM=

# ── Video storage (VIDEO_STORAGE.md) ────────────────────────────────────────
# Where a store's VIDEO files are kept. Unset means local disk, which is the
# default: every byte stays here and nothing else changes. `filemoon` sends
# video uploads to the host, which then also DELIVERS them to the viewer's
# browser — so a third party sees the viewer's IP address (the privacy notice
# says so), and a playback url is a bearer once it is in a browser.
#
# Identity documents and images NEVER go to the host, on any setting.
# VIDEO_DRIVER=filemoon
# FILEMOON_API_BASE=https://filemoon.org/api/v1
# FILEMOON_TOKEN=            # `id|secret`, the whole token, as issued
